# Splitscope settings. Copy to .env and fill in. Everything except CLASH_API / CLASH_SECRET is optional.

# --- the mihomo (Clash Meta) kernel: its external controller ("外部控制") address and secret
# OpenClash: 插件设置 → 外部控制 / 管理页面, default port 9090. Check with:
#   curl -H "Authorization: Bearer <secret>" http://192.168.1.1:9090/version
CLASH_API=http://192.168.1.1:9090
CLASH_SECRET=

# Mixed (HTTP + SOCKS5) port, used for probes and for downloading rule data. Default: CLASH_API host + :7893
MIXED_PROXY=

# --- the router (optional; enables device names from DHCP leases, the yaml snapshot, custom rules)
# /host         -> running in Docker on the router itself (files mounted by docker-compose.yml)
# ssh:<alias>   -> running on another machine; reads the files over `ssh <alias>` (key login, see README)
# (leave empty) -> no router files; everything else still works
HOST_FILES=

# The router's own LAN addresses, comma separated. Default: the CLASH_API host.
ROUTER_IPS=

# Devices in these networks may change things (expectations, cases, device names, settings); others
# can only look. Default: the /24 of the first ROUTER_IPS address. The machine running the site can always edit.
EDIT_NETS=

# Exit region for nodes whose names carry no flag or place name: name fragment=country code, comma separated
NODE_REGIONS=

# fake-ip ranges in use (the one in your yaml is read automatically). Default: 198.18.0.0/15
FAKE_IP_RANGE=

PORT=8686
DATA_DIR=./data/cache
