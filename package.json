{
  "name": "splitscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "分流镜 Splitscope：看清 OpenClash / mihomo 每条连接走了哪条规则、哪个策略组，并用内核真实判定任意域名、IP、App 的分流",
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build": "npm run build:web && npm run build:server && mkdir -p dist/data && cp data/services.json dist/data/ && cp -R data/curated dist/data/",
    "start": "node --no-warnings --env-file=.env dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build:web && node --no-warnings --import tsx scripts/demo/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "maxmind": "^5.0.7",
    "tldts": "^7.4.18",
    "undici": "^8.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/funnel-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
